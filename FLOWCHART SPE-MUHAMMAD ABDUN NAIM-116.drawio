        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD;\n  A--&gt;B;\n  A--&gt;C;\n  B--&gt;D;\n  C--&gt;D;flowchart TD\n    subgraph STAGE1 [\&quot;1. Hardware Reconnaissance &amp; Pinout Mapping\&quot;]\n        A[Inspeksi PCB &amp; Komponen Utama] --&gt; B[Identifikasi MCU, Gate Driver, MOSFET, Shunt Resistor]\n        B --&gt; C[Tracing Jalur PCB &amp; Skematik]\n        C --&gt; D1[Mapping Pinout MCU ke Gate Driver PWM]\n        C --&gt; D2[Mapping Pinout MCU ke Sense Arus &amp; Tegangan ADC]\n        C --&gt; D3[Mapping Antarmuka Komunikasi UART / CAN / SWD]\n    end\n\n    subgraph STAGE2 [\&quot;2. Firmware Extraction &amp; Disassembly\&quot;]\n        E[Koneksi SWD / JTAG Pinout] --&gt; F{Cek Proteksi RDP Readout Protection}\n        F -- Locked / RDP Active --&gt; G[Glitching / Side-Channel Attack Bypass]\n        F -- Unlocked --&gt; H[Dump Memory Flash &amp; Option Bytes]\n        G --&gt; H\n        H --&gt; I[Disassembly &amp; Decompilation Ghidra / IDA Pro]\n        I --&gt; J[Mapping Vector Table &amp; Inisialisasi Register]\n    end\n\n    subgraph STAGE3 [\&quot;3. Algoritma FOC &amp; Peripheral Tracing\&quot;]\n        J --&gt; K[Identifikasi Konfigurasi Perifer]\n        K --&gt; L1[Timers &amp; Complementary PWM Dead-Time]\n        K --&gt; L2[ADC Injected Channels &amp; Trigger Sync]\n        L1 --&gt; M[Analisis Algoritma Field Oriented Control FOC]\n        L2 --&gt; M\n        M --&gt; N1[Transformasi Clarke &amp; Park]\n        M --&gt; N2[Loop PI Current Id/Iq &amp; PID Speed/Position]\n        M --&gt; N3[Observer / Estimator Posisi Hall, Encoder, Sensorless]\n        M --&gt; N4[Generasi SVPWM Space Vector Modulation]\n    end\n\n    subgraph STAGE4 [\&quot;4. Protocol Sniffing &amp; SmartESC Analysis\&quot;]\n        O[Sniffing Komunikasi Bus CAN / UART] --&gt; P[Analisis Frame Data &amp; Telemetri]\n        P --&gt; Q[Dekoding Protokol VESC / Custom SmartESC]\n        Q --&gt; R[Mapping Parameter Konfigurasi &amp; Command Set]\n    end\n\n    subgraph STAGE5 [\&quot;5. Validasi Sinyal &amp; Implementasi Ulang\&quot;]\n        D1 &amp; D2 &amp; D3 --&gt; S\n        N1 &amp; N2 &amp; N3 &amp; N4 --&gt; S\n        R --&gt; S\n        S[Pengukuran Logic Analyzer / Osiloskop] --&gt; T[Validasi Timing Sinyal Dead-Time, ADC Trigger, PWM Phase]\n        T --&gt; U[Porting Firmware VESC / Custom Firmware Development]\n        U --&gt; V[Bench Testing Motor dengan Beban]\n    end\n\n    STAGE1 --&gt; STAGE2\n    STAGE2 --&gt; STAGE3\n    STAGE3 --&gt; STAGE4\n    STAGE4 --&gt; STAGE5&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="NkhRivhOf54Rel6DUFLI-1">
